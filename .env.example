# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-side only (do NOT expose to client)
# Used for admin operations, RLS bypass, etc.
# Add this ONLY in Vercel Environment Variables (not committed to git)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WARNING: server-only, never commit a real value.
# Required for privileged auth operations (e.g. deleteAccount).
# Set in Vercel Dashboard → Settings → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar Integration (server-only, never commit real values)
# Setup: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Enable: Google Calendar API
# Redirect URI (dev):  http://localhost:3000/auth/calendar/callback
# Redirect URI (prod): https://your-domain.com/auth/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/calendar/callback
